# ═══════════════════════════════════════
# CẤU HÌNH BẮT BUỘC (REQUIRED)
# ═══════════════════════════════════════

# Số tiền sản phẩm (số nguyên, đơn vị VNĐ)
COURSE_AMOUNT=499000

# SePay API Key — Lấy tại: https://my.sepay.vn/settings/api
SEPAY_API_KEY=

# Google Apps Script URL — Ghi lead & đơn hàng vào Google Sheet
GOOGLE_SCRIPT_URL=

# ═══════════════════════════════════════
# TELEGRAM THÔNG BÁO ĐƠN HÀNG (KHUYẾN NGHỊ)
# ═══════════════════════════════════════

# Token Bot Telegram — Tạo tại: @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=

# Chat ID nhận tin nhắn — Lấy tại: @userinfobot trên Telegram
TELEGRAM_CHAT_ID=

# ═══════════════════════════════════════
# TÙY CHỌN (OPTIONAL)
# ═══════════════════════════════════════

# Make.com Webhook URL (tự động hóa CRM/Email)
MAKE_WEBHOOK_URL=

# Resend API Key (gửi email tự động)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SELLER_EMAIL=
